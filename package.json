{
	"name": "@orgsdk/plugin-browser",
	"version": "1.1.2",
	"description": "Hardened HTML\u2192PDF renderer (headless Chromium, JS disabled, all external requests blocked)",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:integration": "BROWSER_INTEGRATION=1 bun test",
		"validate": "orgsdk-plugin validate",
		"package": "orgsdk-plugin package",
		"version-guard": "orgsdk-plugin version-guard",
		"build": "bun run typecheck && bun run validate && bun run package",
		"publish:catalog": "orgsdk-plugin publish",
		"build:npm": "node scripts/build-npm.mjs",
		"test:executor": "node scripts/test-executor.mjs",
		"pack:npm": "npm pack ./dist/npm --ignore-scripts",
		"test:registration": "node scripts/test-registration.mjs"
	},
	"dependencies": {
		"playwright": "1.64.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@orgsdk/plugins": "0.2.2",
		"@types/bun": "^1.3.9",
		"typescript": "~6.0.3",
		"@orgsdk/executor": "0.1.0"
	},
	"patchedDependencies": {
		"@orgsdk/executor@0.1.0": "patches/@orgsdk%2Fexecutor@0.1.0.patch"
	},
	"license": "Apache-2.0",
	"author": "OrgSDK",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OrgSDK/orgsdk-plugin-browser.git"
	},
	"bugs": {
		"url": "https://github.com/OrgSDK/orgsdk-plugin-browser/issues"
	},
	"homepage": "https://github.com/OrgSDK/orgsdk-plugin-browser#readme",
	"overrides": {
		"zod": "4.6.7"
	}
}
